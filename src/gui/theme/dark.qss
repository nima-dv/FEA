/* DarkVision dark theme. The "dollar-token" placeholders are substituted by theme/__init__.py -
   see PALETTE there for the authoritative values. Orange is interaction and emphasis ONLY:
   it marks what you can act on, what has focus, and what is running. Nothing decorative.

   Corner radii follow one scale app-wide: 6px for controls (inputs, buttons, list rows),
   8px for containers (cards, group boxes). Tables stay sharp - Qt does not clip cell content
   to a rounded table border, so rounding one there reads as a bug, not a style. */

QWidget {
    background: $bg;
    color: $ink;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
}

QToolTip {
    background: $surface_hi;
    color: $ink;
    border: 1px solid $accent_lo;
    border-radius: 4px;
    padding: 6px 8px;
}

/* ---- structure -------------------------------------------------------------- */

QFrame#rail {
    background: $surface;
    border-right: 1px solid $rule;
}

QFrame[role="card"] {
    background: $surface;
    border: 1px solid $rule;
    border-radius: 8px;
}

QFrame[role="hrule"] {
    background: $rule;
    max-height: 1px;
    border: none;
}

QSplitter::handle { background: $rule; width: 1px; }

/* ---- the left rail ---------------------------------------------------------- */

QListWidget#railList {
    background: $surface;
    border: none;
    outline: none;
    padding: 6px 0px;
}

QListWidget#railList::item {
    color: $ink_soft;
    padding: 10px 12px;
    margin: 1px 6px;
    border-radius: 6px;
    border-left: 2px solid transparent;
}

QListWidget#railList::item:hover {
    color: $ink;
    background: $accent_wash;
}

QListWidget#railList::item:selected {
    color: $ink;
    background: $accent_wash;
    border-left: 2px solid $accent;
}

/* ---- text ------------------------------------------------------------------- */

QLabel { background: transparent; }
QLabel#caption, QLabel[role="caption"] {
    color: $ink_soft;
    padding: 1px 0px;
    letter-spacing: 0.1px;
}

QLabel#title {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.4px;
}

/* Numbers are monospace and right-aligned so columns compare by eye. */
QLabel[role="num"], QTableWidget#numbers, QPlainTextEdit#log, QTextEdit#log {
    font-family: $mono;
}

QPlainTextEdit#log, QTextEdit#log {
    background: $surface;
    border: 1px solid $rule;
    border-radius: 6px;
    color: $ink_soft;
    selection-background-color: $accent_lo;
}

/* A field whose value differs from the published baseline carries this 8 px dot. */
QLabel#dot {
    background: $accent;
    border-radius: 4px;
    min-width: 8px;  max-width: 8px;
    min-height: 8px; max-height: 8px;
}
QLabel#dot[on="false"] { background: transparent; }

/* Status words, set with a dynamic property: label.setProperty("state", "ok") */
QLabel[state="ok"]   { color: $ok; }
QLabel[state="warn"] { color: $warn; }
QLabel[state="fail"] { color: $fail; }
QLabel[state="idle"] { color: $idle; }

/* ---- groups ----------------------------------------------------------------- */

QGroupBox {
    background: $surface;
    border: 1px solid $rule;
    border-radius: 8px;
    margin-top: 10px;
    padding: 24px 12px 12px 12px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 2px 6px;
    color: $ink_soft;
    letter-spacing: 0.3px;
}

QGroupBox::title:hover { color: $accent_hi; }

QGroupBox::indicator { width: 9px; height: 9px; }

/* ---- inputs ----------------------------------------------------------------- */

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QAbstractSpinBox {
    background: $surface_hi;
    border: 1px solid $rule;
    border-radius: 6px;
    padding: 5px 8px;
    color: $ink;
    selection-background-color: $accent_lo;
    font-family: $mono;
}

QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover {
    border: 1px solid $accent_lo;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid $accent;
    background: $accent_wash;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    color: $idle;
    background: $surface;
}

QComboBox::drop-down { border: none; width: 20px; }
QComboBox::down-arrow {
    /* No image assets in this app: a 4 px orange square reads as an affordance. */
    width: 4px; height: 4px;
    background: $accent;
}
QComboBox QAbstractItemView {
    background: $surface_hi;
    border: 1px solid $rule;
    border-radius: 6px;
    padding: 2px;
    selection-background-color: $accent_wash;
    selection-color: $ink;
    outline: none;
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background: $surface;
    border-left: 1px solid $rule;
    width: 16px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background: $accent_lo;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow,
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    width: 3px; height: 3px; background: $ink_soft;
}

QCheckBox, QRadioButton { spacing: 8px; background: transparent; }
QCheckBox:disabled, QRadioButton:disabled { color: $idle; }

QCheckBox::indicator, QRadioButton::indicator {
    width: 13px; height: 13px;
    background: $surface_hi;
    border: 1px solid $rule;
}
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator { border-radius: 3px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border: 1px solid $accent_hi;
    background: $accent_wash;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: $accent;
    border: 1px solid $accent;
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { border: 1px solid $idle; }
/* Orange means live. A disabled-but-checked box (e.g. the figures stage with snapshots off)
   must not read as something you can act on. */
QCheckBox::indicator:checked:disabled, QRadioButton::indicator:checked:disabled {
    background: $idle;
    border: 1px solid $idle;
}

/* ---- buttons ---------------------------------------------------------------- */

QPushButton {
    background: $surface_hi;
    border: 1px solid $rule;
    border-radius: 6px;
    padding: 7px 16px;
    color: $ink;
}
QPushButton:hover  { background: $accent_wash; border: 1px solid $accent_hi; color: $accent_hi; }
QPushButton:pressed { background: $accent_lo; color: $ink; }
QPushButton:disabled { color: $idle; border: 1px solid $rule; background: $surface; }

QPushButton#primary {
    background: $accent;
    border: 1px solid $accent;
    color: $bg;
    font-weight: 600;
}
QPushButton#primary:hover   { background: $accent_hi; border-color: $accent_hi; color: $bg; }
QPushButton#primary:pressed { background: $accent_lo; border-color: $accent_lo; }
QPushButton#primary:disabled {
    background: $surface;
    border: 1px solid $rule;
    color: $idle;
}

/* ---- tables ----------------------------------------------------------------- */

QTableWidget, QTableView, QTreeView {
    background: $surface;
    alternate-background-color: $surface_hi;
    border: 1px solid $rule;
    gridline-color: $rule;
    selection-background-color: $accent_wash;
    selection-color: $ink;
    outline: none;
}

QHeaderView::section {
    background: $surface_hi;
    color: $ink_soft;
    border: none;
    border-bottom: 1px solid $rule;
    padding: 6px 8px;
    font-weight: 600;
}

QTableCornerButton::section { background: $surface_hi; border: none; }

/* ---- progress and scrollbars ------------------------------------------------ */

QProgressBar {
    background: $surface_hi;
    border: 1px solid $rule;
    border-radius: 6px;
    text-align: center;
    color: $ink;
    font-family: $mono;
    max-height: 14px;
}
QProgressBar::chunk { background: $accent; border-radius: 5px; }

QScrollBar:vertical   { background: $bg; width: 10px; margin: 0; }
QScrollBar:horizontal { background: $bg; height: 10px; margin: 0; }
QScrollBar::handle {
    background: $rule;
    border-radius: 5px;
    min-height: 24px;
    min-width: 24px;
}
QScrollBar::handle:hover { background: $idle; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QScrollArea { border: none; }

/* ---- status bar ------------------------------------------------------------- */

QStatusBar {
    background: $surface;
    border-top: 1px solid $rule;
    color: $ink_soft;
    padding: 2px 4px;
}
QStatusBar::item { border: none; }
QStatusBar QLabel { color: $ink_soft; font-family: $mono; }
