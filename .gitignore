# Repo-root ignores. data/ and src/backend/ carry their own for their own artefacts.

# Their MAT dumps are never small, and *_workspace.mat is ~122 MB - OVER GITHUB'S HARD
# 100 MB PER-FILE LIMIT, so a push carrying one is rejected outright. Blanket rule so a
# stray copy anywhere cannot slip in.
*.mat

# Python
__pycache__/
*.pyc
.venv/

# OS / editor
Thumbs.db
.DS_Store
.vscode/
.idea/
